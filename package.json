{
  "name": "clawgym",
  "version": "0.1.0",
  "description": "ClawGym — тестовый стенд обучения агента Pagurus: заглушки MCP, LLM-оператор, корзины, оценки и метрики",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "main": "dist/src/main.js",
  "bin": {
    "clawgym": "dist/src/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/src/main.js",
    "validate": "node dist/src/cli.js validate",
    "dev:agent": "node dist/dev/fake-agent/main.js",
    "dev:llm": "node dist/dev/fake-llm/main.js",
    "demo": "node dist/dev/demo.js",
    "test": "npm run build && node --test dist/test/*.test.js",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "yaml": "2.9.1"
  },
  "optionalDependencies": {
    "@anthropic-ai/sdk": "1.3.0"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "typescript": "5.9.3"
  }
}
